---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="Sorry, that page could not be found." noindex>
  <section class="section section--dark"><div class="wrap center narrow">
    <p class="eyebrow">404</p>
    <h1>Oops, this page has washed off!</h1>
    <p class="lead">The page you're looking for doesn't exist. Try one of these instead:</p>
    <div class="btn-row"><a class="btn btn--light" href="/">Home</a><a class="btn btn--ghost" href="/gallery/">Gallery</a><a class="btn btn--ghost" href="/pricing/">Pricing</a></div>
  </div></section>
</Base>
