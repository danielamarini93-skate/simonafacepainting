---
import Base from '../layouts/Base.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<Base title="Thank you" description="Thanks for your enquiry." noindex>
  <section class="section section--dark"><div class="wrap center narrow">
    <p class="eyebrow">Enquiry sent</p>
    <h1>Thank you! ✨</h1>
    <p class="lead">Simona will get back to you as soon as possible. For a faster reply, drop her a message on WhatsApp too.</p>
    <div class="btn-row"><WhatsAppButton /><a class="btn btn--ghost" href="/gallery/">Browse the gallery</a></div>
  </div></section>
</Base>
