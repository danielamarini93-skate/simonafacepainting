---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import GalleryDeck from '../components/GalleryDeck.astro';
import VideoLoop from '../components/VideoLoop.astro';
import CtaBand from '../components/CtaBand.astro';
import { gallery } from '../lib/gallery';
import { breadcrumbSchema } from '../lib/schema';
import videos from '../data/videos.json';
const order = ['kids', 'adults', 'glitter-bar', 'glitter-tattoos', 'seasonal', 'corporate'];
const items = [...gallery].sort((a, b) => Number(!!b.featured) - Number(!!a.featured) || order.indexOf(a.category) - order.indexOf(b.category));
---
<Base title="Face Painting Gallery | Kids, Adults, Glitter & Halloween Designs" description="Browse our face painting portfolio: children's designs, adult face art, glitter bar looks, glitter tattoos and Halloween & Day of the Dead designs from London events." schema={[breadcrumbSchema([{ name: 'Gallery', path: '/gallery/' }])]}>
  <PageHero eyebrow="Portfolio" title="Gallery" lead="Real designs from real London parties and events. Tap any photo to see it larger, or filter by style." crumbs={[{ name: 'Gallery', path: '/gallery/' }]} />
  <section class="section deck-section">
    <div class="wrap center">
      <p class="eyebrow">Favourites</p>
      <h2>Swipe through the <em>sparkle</em></h2>
      <GalleryDeck items={items.filter((i) => i.featured)} />
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="center head"><p class="eyebrow">Every design</p><h2>Browse by style</h2></div>
      <GalleryGrid items={items} filters eager={0} />
    </div>
  </section>
  <section class="section section--dark">
    <div class="wrap">
      <div class="center head"><p class="eyebrow">Videos</p><h2>Watch Simona at work</h2></div>
      <ul class="vids">
        {videos.map((v) => <li><VideoLoop id={v.id} /><p>{v.title}</p></li>)}
      </ul>
      <p class="center insta">More every week on <a href="https://www.instagram.com/simonasfacepainting/" target="_blank" rel="noopener">Instagram @simonasfacepainting</a></p>
    </div>
  </section>
  <CtaBand title="Love what you see?" />
</Base>
<style>
  .head { margin-bottom: 40px; }
  .deck-section { padding-bottom: 0; }
  .deck-section h2 { margin-bottom: 28px; }
  .vids { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); max-width: 960px; margin-inline: auto; }
  .vids :global(.video-loop) { aspect-ratio: 9/16; }
  .vids p { margin: 10px 0 0; font-size: .92rem; color: var(--muted-on-dark); text-align: center; }
  .insta { margin-top: 36px; }
</style>
