---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../lib/site';
import { businessSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object[];
  heroOverlay?: boolean; // header floats over a dark hero
  noindex?: boolean;
}
const { title, description, image = '/og-image.jpg', schema = [], heroOverlay = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes('Simona') ? title : `${title} | Simona's Face Painting`;
const ogImage = new URL(image, site.url).href;
const allSchema = [businessSchema(), ...schema];
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0c0a0e" />
    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overlay={heroOverlay} />
    <main id="main"><slot /></main>
    <Footer />

    <a class="wa-fab" href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp" aria-label="Message Simona on WhatsApp">
      <Icon name="whatsapp" />
    </a>
    <nav class="contact-bar" aria-label="Quick contact">
      <a href={site.phoneHref} data-track="call"><Icon name="phone" /> Call</a>
      <a class="wa" href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp"><Icon name="whatsapp" /> WhatsApp</a>
    </nav>

    <script>
      // Reveal-on-scroll (content is visible without JS; this is enhancement only)
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Play looping videos only while visible; respect reduced motion & data saver
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData;
      const vids = document.querySelectorAll<HTMLVideoElement>('video[data-loop]');
      if (!reduce) {
        const vio = new IntersectionObserver((entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              if (!v.src && v.dataset.src) v.src = v.dataset.src;
              v.play().catch(() => {});
            } else v.pause();
          }
        }, { rootMargin: '200px' });
        vids.forEach((v) => vio.observe(v));
      }

      // Analytics hook for WhatsApp clicks (Cloudflare Web Analytics counts page views;
      // this custom event is picked up if a tag manager is ever added).
      document.addEventListener('click', (ev) => {
        const a = (ev.target as Element).closest?.('[data-track]');
        if (a) (window as any).dataLayer?.push({ event: (a as HTMLElement).dataset.track + '_click', page: location.pathname });
      });
    </script>
    {cfToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>
    )}
  </body>
</html>

<style is:global>
  /* Desktop: floating WhatsApp bubble. Phones: fixed Call / WhatsApp bar. */
  .wa-fab {
    position: fixed; right: 20px; bottom: 20px; z-index: 60; display: none;
    width: 60px; height: 60px; place-items: center; border-radius: 50%;
    background: var(--wa-deep); color: #fff;
    box-shadow: 0 14px 34px -10px rgba(18, 140, 74, 0.7); transition: transform .2s ease;
  }
  .wa-fab:hover { transform: translateY(-2px) scale(1.04); }
  .wa-fab svg { width: 30px; height: 30px; }
  .contact-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    display: grid; grid-template-columns: 1fr 1.4fr; gap: 10px;
    padding: 10px max(12px, env(safe-area-inset-left)) calc(10px + env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-right));
    background: rgba(9, 8, 11, .92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line-dark);
  }
  .contact-bar a {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px;
    border-radius: 999px; font-weight: 600; text-decoration: none; color: var(--pearl);
    border: 1px solid rgba(243,250,243,.3);
  }
  .contact-bar a.wa { background: var(--wa-deep); border-color: var(--wa-deep); color: #fff; }
  .contact-bar svg { width: 22px; height: 22px; }
  body { padding-bottom: calc(72px + env(safe-area-inset-bottom)); }
  @media (min-width: 900px) {
    .contact-bar { display: none; }
    .wa-fab { display: grid; }
    body { padding-bottom: 0; }
  }
</style>
