---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../lib/site';
import { businessSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object[];
  heroOverlay?: boolean; // header floats over a dark hero (home page; hero has its own WhatsApp button)
  noindex?: boolean;
  heroCta?: boolean; // page's first screen already has its own WhatsApp button (phone bar waits)
  ownTopCta?: boolean; // ...and the header's 'Get a quote' button waits too
}
const { title, description, image = '/og-image.jpg', schema = [], heroOverlay = false, noindex = false, heroCta = false, ownTopCta = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes('Simona') ? title : `${title} | Simona's Face Painting`;
const ogImage = new URL(image, site.url).href;
const allSchema = [businessSchema(), ...schema];
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0c0a0e" />
    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class:list={[{ 'hero-cta': heroOverlay || heroCta, 'home-hero': heroOverlay || ownTopCta }]}>
    <a class="skip" href="#main">Skip to content</a>
    <Header overlay={heroOverlay} />
    <main id="main"><slot /></main>
    <Footer />

    <a class="wa-fab" href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp" aria-label="Message Simona on WhatsApp">
      <Icon name="whatsapp" />
    </a>

    <script>
      import '../scripts/glitter';
    </script>
    <script>
      // Only one WhatsApp button on screen at the top of a page: floating buttons appear after scrolling.
      const onScrollCta = () => document.body.classList.toggle('scrolled-past', scrollY > Math.min(innerHeight * 0.8, 640));
      addEventListener('scroll', onScrollCta, { passive: true }); onScrollCta();

      // Reveal-on-scroll (content is visible without JS; this is enhancement only)
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Play looping videos only while visible; respect reduced motion & data saver
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData;
      const vids = document.querySelectorAll<HTMLVideoElement>('video[data-loop]');
      if (!reduce) {
        const vio = new IntersectionObserver((entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              if (!v.src && v.dataset.src) v.src = v.dataset.src;
              v.play().catch(() => {});
            } else v.pause();
          }
        }, { rootMargin: '200px' });
        vids.forEach((v) => vio.observe(v));
      }

      // Analytics hook for WhatsApp clicks (Cloudflare Web Analytics counts page views;
      // this custom event is picked up if a tag manager is ever added).
      document.addEventListener('click', (ev) => {
        const a = (ev.target as Element).closest?.('[data-track]');
        if (a) (window as any).dataLayer?.push({ event: (a as HTMLElement).dataset.track + '_click', page: location.pathname });
      });
    </script>
    {cfToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>
    )}
  </body>
</html>

<style is:global>
  .glitter-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
  .glitter-burst { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 200; }
  /* Desktop only: floating WhatsApp bubble (nothing fixed at the bottom on phones). */
  .wa-fab {
    position: fixed; right: 20px; bottom: 20px; z-index: 60; display: none;
    width: 60px; height: 60px; place-items: center; border-radius: 50%;
    background: var(--grad-cta); color: #fff;
    box-shadow: 0 14px 34px -10px rgba(155, 47, 217, 0.75); transition: transform .2s ease;
  }
  .wa-fab:hover { transform: translateY(-2px) scale(1.04); }
  /* Hidden at the top of every page (header / hero already has WhatsApp) */
  body:not(.scrolled-past) .wa-fab { opacity: 0; pointer-events: none; transform: translateY(20px); }
  .wa-fab { transition: opacity .3s ease, transform .3s ease; }
  /* Home page: the hero's own button is the WhatsApp at the top, so the bar waits */
  body.home-hero:not(.scrolled-past) .header-cta,
  body.home-hero:not(.scrolled-past) .call-mobile { display: none; }
  .wa-fab svg { width: 30px; height: 30px; }
  @media (min-width: 900px) {
    .wa-fab { display: grid; }
  }
</style>
