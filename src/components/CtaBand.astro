---
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
import { site } from '../lib/site';
interface Props { title?: string; text?: string; }
const { title = 'Let’s add some sparkle to your event', text = 'Tell us your date, area and number of guests on WhatsApp and Simona will reply with availability and a quote, usually the same day.' } = Astro.props;
---
<section class="cta section section--dark">
  <div class="wrap center narrow">
    <p class="eyebrow">Check availability</p>
    <h2>{title}</h2>
    <p class="lead">{text}</p>
    <div class="btn-row">
      <WhatsAppButton />
      <a class="btn btn--ghost" href={site.phoneHref}><Icon name="phone" /> Call {site.phoneDisplay}</a>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; overflow: hidden; background: radial-gradient(1100px 460px at 30% 125%, rgba(120,70,220,.26), transparent 72%), radial-gradient(1100px 460px at 72% 125%, rgba(200,80,180,.22), transparent 72%), var(--ink); }
  .cta h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.8rem, 6vw, 4.6rem); line-height: 1.05; background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; padding: 0 .1em; }
</style>
