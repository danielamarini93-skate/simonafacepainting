---
import Icon from './Icon.astro';
import { trust } from '../data/content';
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<ul class:list={['trust', { dark }]}>
  {trust.map((t) => <li><span class="ic"><Icon name="check" /></span><span><strong>{t.title}</strong><small>{t.text}</small></span></li>)}
</ul>
<style>
  /* Icon and text side by side, both aligned to the same top line, in a tidy 2x2 (phone) / 4-up grid */
  .trust { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px 16px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .trust { grid-template-columns: repeat(4, 1fr); } }
  .trust li { display: grid; grid-template-columns: 32px 1fr; gap: 12px; align-items: start; min-width: 0; }
  .ic { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: transparent; border: 1px solid var(--pink-text); color: var(--pink-text); }
  .ic :global(svg) { width: 16px; height: 16px; }
  .trust li > span:last-child { padding-top: 4px; min-width: 0; }
  strong { display: block; font-weight: 500; line-height: 1.2; }
  small { color: var(--muted); font-size: .85rem; line-height: 1.3; display: block; }
  .dark small { color: var(--muted-on-dark); }
  .dark .ic { background: transparent; }
</style>
