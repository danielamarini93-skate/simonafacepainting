---
// A moving photo wall: several rows of photos gliding slowly in alternating directions,
// so lots of designs are visible at once. Touch / hover pauses a row; tapping a photo
// opens it large (with a glitter burst). With reduced motion the rows are still and
// can be scrolled sideways by hand.
import { Image, getImage } from 'astro:assets';
import type { GalleryItem } from '../lib/gallery';
interface Props { items: GalleryItem[]; rows?: number; }
const { items, rows = 3 } = Astro.props;
const lines: GalleryItem[][] = Array.from({ length: rows }, (_, r) => items.filter((_, i) => i % rows === r));
const fulls = new Map(await Promise.all(items.map(async (i) => [i.file, (await getImage({ src: i.src, width: Math.min(1400, i.src.width), format: 'webp', quality: 78 })).src] as const)));
const speeds = [70, 85, 78, 92];
---
<div class="wall" data-wall>
  {lines.map((line, r) => (
    <div class="row" style={`--dur:${speeds[r % speeds.length]}s`} data-dir={r % 2 ? 'right' : 'left'}>
      <ul class="track">
        {[0, 1].map((copy) => line.map((item) => (
          <li aria-hidden={copy === 1 ? 'true' : undefined}>
            <a href={fulls.get(item.file)} data-full tabindex={copy === 1 ? -1 : undefined} aria-label={`Enlarge: ${item.alt}`} draggable="false">
              <Image src={item.src} alt={copy === 1 ? '' : item.alt} widths={[320, 480]} sizes="180px" loading="lazy" draggable="false" />
            </a>
          </li>
        )))}
      </ul>
    </div>
  ))}
  <dialog class="wall-lightbox" aria-label="Photo viewer">
    <button type="button" class="close" aria-label="Close">×</button>
    <img alt="" />
    <p class="cap"></p>
  </dialog>
</div>

<script>
  import { burst } from '../scripts/glitter';
  document.querySelectorAll<HTMLElement>('[data-wall]').forEach((wall) => {
    const dlg = wall.querySelector('dialog')!;
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector('.cap')!;
    let moved = false, sx = 0;
    wall.addEventListener('pointerdown', (e) => { moved = false; sx = e.clientX; (e.target as Element).closest('.row')?.classList.add('held'); });
    wall.addEventListener('pointermove', (e) => { if (Math.abs(e.clientX - sx) > 8) moved = true; });
    const release = () => wall.querySelectorAll('.held').forEach((r) => r.classList.remove('held'));
    addEventListener('pointerup', release); addEventListener('pointercancel', release);
    wall.querySelectorAll<HTMLAnchorElement>('a[data-full]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      if (moved) return;
      const thumb = a.querySelector('img')!;
      burst((e as MouseEvent).clientX, (e as MouseEvent).clientY, 22);
      img.src = a.href; img.alt = thumb.alt || a.getAttribute('aria-label')!.replace('Enlarge: ', '');
      cap.textContent = img.alt;
      dlg.showModal();
    }));
    dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>

<style>
  .wall { display: grid; gap: 10px; margin-inline: calc(-1 * var(--gutter)); overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  @media (min-width: 900px) { .wall { gap: 14px; } }
  .row { overflow: hidden; }
  .track { list-style: none; margin: 0; padding: 0; display: flex; gap: 10px; width: max-content; animation: wall-left var(--dur) linear infinite; }
  .row[data-dir='right'] .track { animation-name: wall-right; }
  .row:hover .track, .row.held .track, .row:focus-within .track { animation-play-state: paused; }
  @keyframes wall-left { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 5px)); } }
  @keyframes wall-right { from { transform: translateX(calc(-50% - 5px)); } to { transform: translateX(0); } }
  li { flex: none; }
  a { display: block; height: 150px; border-radius: 8px; overflow: hidden; background: var(--paper); -webkit-tap-highlight-color: transparent; }
  @media (min-width: 900px) { a { height: 220px; } .track { gap: 14px; } }
  a :global(img) { height: 100%; width: auto; display: block; object-fit: cover; -webkit-user-drag: none; user-select: none; transition: transform .5s ease, filter .5s ease; }
  a:hover :global(img) { transform: scale(1.05); }
  a:focus-visible { outline: 2px solid var(--pink-text); outline-offset: -2px; }

  @media (prefers-reduced-motion: reduce) {
    .row { overflow-x: auto; scrollbar-width: none; }
    .track { animation: none; }
  }

  .wall-lightbox { border: 0; padding: 0; background: transparent; width: 100vw; height: 100dvh; max-width: 100vw; max-height: 100dvh; margin: 0; }
  .wall-lightbox::backdrop { background: rgba(8,6,10,.94); }
  .wall-lightbox[open] { display: grid; place-items: center; }
  .wall-lightbox img { max-width: min(92vw, 1100px); max-height: 80dvh; width: auto; height: auto; border-radius: 8px; }
  .wall-lightbox .cap { position: absolute; bottom: 18px; left: 0; right: 0; text-align: center; color: var(--pearl); font-size: .92rem; margin: 0; padding: 0 56px; }
  .wall-lightbox .close { position: absolute; top: 14px; right: 14px; width: 48px; height: 48px; border-radius: 50%; border: 0; background: rgba(255,255,255,.1); color: #fff; font-size: 28px; cursor: pointer; }
</style>
