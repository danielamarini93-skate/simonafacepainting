---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WhatsAppButton from './WhatsAppButton.astro';
interface Props { eyebrow?: string; title: string; lead?: string; image?: ImageMetadata; imageAlt?: string; crumbs?: { name: string; path: string }[]; cta?: boolean; }
const { eyebrow, title, lead, image, imageAlt = '', crumbs = [], cta = true } = Astro.props;
---
<section class="page-hero section--dark">
  <div class="wrap inner" class:list={[{ 'has-img': !!image }]}>
    <div class="copy">
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs"><a href="/">Home</a>{crumbs.map((c, i) => <><span aria-hidden="true">/</span>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</>)}</nav>
      )}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      {cta && <div class="btn-row"><WhatsAppButton label="Get a quote on WhatsApp" /><slot name="actions" /></div>}
    </div>
    {image && <div class="art"><Image src={image} alt={imageAlt} widths={[400, 720]} sizes="(min-width: 900px) 440px, 90vw" loading="eager" fetchpriority="high" /></div>}
  </div>
</section>
<style>
  .page-hero { padding: clamp(48px, 7vw, 96px) 0; background: radial-gradient(900px 420px at 85% 0%, rgba(233,52,232,.22), transparent 70%), var(--ink); }
  .inner { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .inner.has-img { grid-template-columns: 1.2fr .8fr; } }
  .lead { color: var(--muted-on-dark); }
  .art { justify-self: center; width: min(440px, 100%); }
  .art :global(img) { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 220px 220px var(--radius-lg) var(--radius-lg); box-shadow: 0 30px 80px -30px rgba(233,52,232,.45); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: .85rem; color: var(--muted-on-dark); margin-bottom: 18px; }
  .crumbs a { color: inherit; }
  h1 { max-width: 20ch; }
</style>
