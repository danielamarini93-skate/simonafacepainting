---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.jpg';
import Icon from './Icon.astro';
import { nav } from '../lib/nav';
import { whatsappUrl, site } from '../lib/site';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class:list={['site-header', { overlay }]} data-header>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Simona's Face Painting, home">
      <span class="badge"><Image src={logo} alt="" width={56} height={56} loading="eager" /></span>
      <span class="wordmark display">Simona's<br /><small>Face Painting</small></span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {nav.map((item) => item.children ? (
          <li class="has-sub">
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            <ul class="sub">
              {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
            </ul>
          </li>
        ) : (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--wa header-cta" href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp"><Icon name="whatsapp" /> Get a quote</a>

    <a class="call-mobile" href={site.phoneHref} aria-label={`Call Simona on ${site.phoneDisplay}`}><Icon name="phone" /></a>
    <details class="nav-mobile">
      <summary aria-label="Open menu"><Icon name="menu" /></summary>
      <div class="drawer">
        <ul>
          <li><a href="/">Home</a></li>
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
              {item.children && <ul>{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>}
            </li>
          ))}
        </ul>
        <a class="btn btn--wa" href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp"><Icon name="whatsapp" /> Message on WhatsApp</a>
      </div>
    </details>
  </div>
</header>

<script>
  const h = document.querySelector('[data-header]');
  const onScroll = () => h?.classList.toggle('scrolled', scrollY > 30);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(12,10,14,.94); color: var(--pearl); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--line-dark); transition: background .3s ease, padding .3s ease; }
  .site-header.overlay { position: fixed; inset: 0 0 auto 0; background: linear-gradient(to bottom, rgba(12,10,14,.75), rgba(12,10,14,0)); border-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .site-header.overlay.scrolled { background: rgba(12,10,14,.94); border-color: var(--line-dark); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  @media (max-width: 1079px) {
    .site-header, .site-header.overlay.scrolled { border-bottom: 0; }
    .site-header.overlay:not(.scrolled) { background: linear-gradient(to bottom, rgba(9,8,11,.6), rgba(9,8,11,0)); }
    .site-header.overlay.scrolled, .site-header:not(.overlay) { background: var(--ink); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }
  .bar { display: flex; align-items: center; gap: 10px; min-height: 76px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; margin-right: auto; }
  .badge { width: 52px; height: 52px; border-radius: 3px; overflow: hidden; background: #fff; flex: none; box-shadow: 0 6px 18px -6px rgba(0,0,0,.5); }
  .badge :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); }
  .wordmark { font-size: 1.3rem; line-height: 1; font-style: italic; }
  .wordmark small { display: block; margin-top: 4px; font-family: var(--font-body); font-weight: 400; font-size: .6rem; letter-spacing: .34em; text-transform: uppercase; color: var(--pink-text); }

  .nav-desktop { display: none; }
  .nav-desktop > ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav-desktop a { display: block; padding: 10px 12px; text-decoration: none; font-size: .84rem; font-weight: 400; letter-spacing: .14em; text-transform: uppercase; border-radius: 2px; color: rgba(243,250,243,.86); }
  .nav-desktop a:hover, .nav-desktop a[aria-current] { color: #fff; background: rgba(255,255,255,.08); }
  .has-sub { position: relative; }
  .sub { position: absolute; left: 0; top: 100%; min-width: 260px; list-style: none; margin: 0; padding: 10px; background: var(--ink-2); border: 1px solid var(--line-dark); border-radius: 3px; box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(6px); transition: .2s ease; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { text-transform: none; letter-spacing: .02em; font-size: .95rem; border-radius: 3px; }
  .header-cta { display: none; min-height: 44px; padding: .7em 1.2em; font-size: .88rem; }

  .call-mobile { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 3px; border: 1px solid var(--line-dark); color: var(--pearl); }
  .call-mobile :global(svg) { width: 22px; height: 22px; }
  .nav-mobile { position: relative; }
  .nav-mobile summary { list-style: none; cursor: pointer; width: 48px; height: 48px; display: grid; place-items: center; border-radius: 3px; border: 1px solid var(--line-dark); }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .drawer { position: fixed; left: 12px; right: 12px; top: 84px; max-height: calc(100dvh - 100px); overflow: auto; padding: 18px; background: var(--ink-2); border: 1px solid var(--line-dark); border-radius: 3px; box-shadow: var(--shadow); }
  .drawer ul { list-style: none; margin: 0 0 16px; padding: 0; }
  .drawer a:not(.btn) { display: block; padding: 11px 8px; text-decoration: none; font-family: var(--font-head); font-size: 1.15rem; border-bottom: 1px solid var(--line-dark); }
  .drawer ul ul a:not(.btn) { font-family: var(--font-body); font-size: .98rem; padding-left: 20px; color: var(--muted-on-dark); }
  .drawer .btn { width: 100%; }

  @media (min-width: 1080px) {
    .nav-desktop { display: block; }
    .header-cta { display: inline-flex; }
    .nav-mobile, .call-mobile { display: none; }
  }
</style>
