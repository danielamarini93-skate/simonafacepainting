---
// A fanned deck of photo cards. Flick the top card left or right (finger or mouse),
// or use the arrows / keyboard. The card flies off with a glitter burst and goes
// to the back of the deck. Without JavaScript it shows the top photo plus a link.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { GalleryItem } from '../lib/gallery';
interface Props { items: GalleryItem[]; }
const { items } = Astro.props;
---
<div class="deck" data-deck>
  <div class="stack" data-stack tabindex="0" role="group" aria-roledescription="photo deck" aria-label="Recent favourites. Swipe or use the arrow keys to see the next photo.">
    {items.map((item, i) => (
      <figure class="dcard" data-card style={`--i:${i}`} aria-hidden={i === 0 ? 'false' : 'true'}>
        <Image src={item.src} alt={item.alt} widths={[400, 720]} sizes="(min-width: 700px) 380px, 80vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} draggable="false" />
      </figure>
    ))}
  </div>
  <div class="controls">
    <button type="button" class="nav prev" data-prev aria-label="Previous photo"><Icon name="arrow" /></button>
    <p class="caption" aria-live="polite"><span data-caption>{items[0]?.alt}</span><span class="count"><span data-index>1</span> / {items.length}</span></p>
    <button type="button" class="nav next" data-next aria-label="Next photo"><Icon name="arrow" /></button>
  </div>
  <p class="hint">Swipe the photos ✨</p>
</div>

<script>
  import { burst } from '../scripts/glitter';
  document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
    const stack = deck.querySelector<HTMLElement>('[data-stack]')!;
    let cards = [...stack.querySelectorAll<HTMLElement>('[data-card]')];
    const n = cards.length;
    const caption = deck.querySelector('[data-caption]')!;
    const index = deck.querySelector('[data-index]')!;
    let pos = 0, busy = false;
    deck.classList.add('ready');

    const layout = () => cards.forEach((c, i) => {
      c.style.setProperty('--i', String(i));
      c.style.zIndex = String(n - i);
      // only the top 3 cards are rendered, so the browser doesn't download every photo at once
      c.style.display = i < 3 || i === n - 1 ? 'block' : 'none';
      c.setAttribute('aria-hidden', i === 0 ? 'false' : 'true');
    });
    const announce = () => {
      caption.textContent = cards[0].querySelector('img')!.alt;
      index.textContent = String(pos + 1);
    };
    layout();

    const fly = (dir: number, x?: number, y?: number) => {
      if (busy) return; busy = true;
      const top = cards[0];
      const r = top.getBoundingClientRect();
      burst(x ?? r.left + r.width / 2, y ?? r.top + r.height / 2, 30);
      top.style.transition = 'transform .45s cubic-bezier(.3,.7,.2,1), opacity .45s';
      top.style.transform = `translate(${dir * 120}%, -6%) rotate(${dir * 24}deg)`;
      top.style.opacity = '0';
      setTimeout(() => {
        top.style.transition = 'none'; top.style.transform = ''; top.style.opacity = '';
        cards = [...cards.slice(1), top];
        pos = (pos + 1) % n;
        layout(); announce();
        requestAnimationFrame(() => { top.style.transition = ''; busy = false; });
      }, 460);
    };
    const back = () => {
      if (busy) return;
      const last = cards[n - 1];
      cards = [last, ...cards.slice(0, -1)];
      pos = (pos - 1 + n) % n;
      last.style.transition = 'none'; last.style.transform = 'translate(-120%, -6%) rotate(-24deg)'; last.style.opacity = '0';
      layout(); announce();
      requestAnimationFrame(() => requestAnimationFrame(() => { last.style.transition = ''; last.style.transform = ''; last.style.opacity = ''; }));
    };

    deck.querySelector('[data-next]')!.addEventListener('click', (e) => fly(1, (e as MouseEvent).clientX || undefined, undefined));
    deck.querySelector('[data-prev]')!.addEventListener('click', back);
    stack.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') fly(1); if (e.key === 'ArrowLeft') back(); });

    // drag / swipe the top card
    let sx = 0, sy = 0, dx = 0, dragging = false, decided = false, horizontal = false;
    stack.addEventListener('pointerdown', (e) => {
      if (busy) return;
      dragging = true; decided = false; horizontal = false; sx = e.clientX; sy = e.clientY; dx = 0;
      cards[0].style.transition = 'none';
    });
    addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const mx = e.clientX - sx, my = e.clientY - sy;
      if (!decided && Math.hypot(mx, my) > 8) { decided = true; horizontal = Math.abs(mx) > Math.abs(my); if (horizontal) stack.setPointerCapture?.(e.pointerId); }
      if (!horizontal) return;
      dx = mx;
      cards[0].style.transform = `translate(${dx}px, ${Math.abs(dx) * -0.04}px) rotate(${dx / 14}deg)`;
    }, { passive: true });
    const end = (e: PointerEvent) => {
      if (!dragging) return; dragging = false;
      const top = cards[0];
      top.style.transition = '';
      if (horizontal && Math.abs(dx) > Math.min(110, stack.clientWidth * 0.28)) fly(Math.sign(dx), e.clientX, e.clientY);
      else top.style.transform = '';
    };
    addEventListener('pointerup', end); addEventListener('pointercancel', end);
  });
</script>

<style>
  .deck { display: grid; justify-items: center; gap: 30px; }
  .stack { position: relative; width: min(78vw, 360px); aspect-ratio: 4 / 5; touch-action: pan-y; outline: none; -webkit-user-select: none; user-select: none; }
  .stack:focus-visible { outline: 2px solid var(--pink-text); outline-offset: 8px; border-radius: 10px; }
  .dcard {
    position: absolute; inset: 0; margin: 0; border-radius: 10px; overflow: hidden; background: var(--paper);
    border: 3px solid #fff; box-shadow: 0 24px 60px -24px rgba(0,0,0,.8), 0 0 0 1px rgba(0,0,0,.4);
    transition: transform .45s cubic-bezier(.3,.7,.2,1), opacity .45s;
  }
  .dcard :global(img) { width: 100%; height: 100%; object-fit: cover; pointer-events: none; -webkit-user-drag: none; }
  /* no-JS: only the top card is visible */
  .dcard:not(:first-child) { display: none; }
  .ready .dcard:not(:first-child) { display: block; }
  /* fanned stack: each card underneath tilts a little more */
  .ready .dcard { transform: translate(calc(var(--i) * 5px), calc(var(--i) * -3px)) rotate(calc((var(--i) * 2.5deg) * var(--side, 1))); }
  .ready .dcard:nth-child(even) { --side: -1; }
  .ready .dcard { opacity: clamp(0, calc(1 - (var(--i) - 2) * 1), 1); }
  .controls { display: grid; grid-template-columns: 48px 1fr 48px; align-items: center; gap: 12px; width: min(92vw, 440px); }
  .nav { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: transparent; color: var(--pearl); border: 1px solid var(--line-dark); cursor: pointer; }
  .nav:hover { border-color: var(--pink-text); }
  .nav :global(svg) { width: 20px; height: 20px; }
  .prev :global(svg) { transform: rotate(180deg); }
  .caption { margin: 0; text-align: center; font-size: .92rem; color: var(--muted); line-height: 1.35; display: grid; gap: 2px; }
  .count { font-size: .72rem; letter-spacing: .2em; color: var(--pink-text); }
  .hint { margin: 0; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  @media (min-width: 900px) { .hint { display: none; } }
  @media (prefers-reduced-motion: reduce) { .dcard { transition: none; } }
</style>
